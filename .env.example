DB_NAME=duo
DB_USERNAME=duo
DB_PASSWORD=change-me-local-db-password

JWT_SECRET=replace-with-random-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
RIOT_API_KEY=replace-with-riot-api-key

# Docker Hub 이미지 태그 (nexusops0713/gamehouse:backend-<여기>)
# CI가 develop 브랜치 머지 시 backend-develop / frontend-develop 을 푸시한다.
# 특정 커밋으로 고정하거나 롤백하려면 커밋 SHA를 넣는다. 예) BACKEND_VERSION=3f1a9c2...
BACKEND_VERSION=develop
FRONTEND_VERSION=develop
