BACKEND_VERSION=develop
FRONTEND_VERSION=develop

# ---------------------------------------------------------------------------
# Observability (docker-compose.observability.yml)
# ---------------------------------------------------------------------------
# Grafana admin 계정. http://localhost:13000
# EC2 처럼 외부에 노출하는 환경에서는 반드시 길고 복잡한 값으로 바꾼다.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=replace-with-strong-password

# Grafana 를 어느 주소로 열 것인가.
#   127.0.0.1 (기본) — 호스트 내부 전용. 로컬 개발은 이대로 둔다.
#   0.0.0.0         — 외부에서 브라우저로 접근. EC2 에서만 사용하고,
#                     반드시 보안그룹에서 13000 을 특정 IP 로만 열 것.
#
# ⚠️ Prometheus(19090) / cAdvisor(18086) / node-exporter(19100) 는 인증이 없다.
#    Grafana 만 로그인 화면이 있어 노출할 수 있는 유일한 서비스다.
# GRAFANA_BIND=0.0.0.0

# Grafana 알람을 보낼 Discord 채널 webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

# 수집한 모든 시계열에 붙는 환경 꼬리표(external_labels.env).
ENV_NAME=prod

# postgres_exporter
PG_EXPORTER_USERNAME=exporter
PG_EXPORTER_PASSWORD=replace-with-strong-password