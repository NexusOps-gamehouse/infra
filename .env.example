DB_NAME=duo
DB_USERNAME=duo
DB_PASSWORD=change-me-local-db-password

JWT_SECRET=replace-with-random-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
RIOT_API_KEY=replace-with-riot-api-key

# 프론트 런타임 주입값 → 컨테이너 시작 시 entrypoint 가 dist/config.js 로 구움.
# 로컬은 serve 에 프록시가 없어 브라우저가 백엔드를 절대 URL 로 직접 호출한다(→ CORS 로 허용).
# ⚠️ 비우면 상대경로(/api,/ws)로 동작 = ALB same-origin 전용. 로컬에서 비우면 :5173 으로 요청이 가 깨진다.
FRONTEND_API_BASE_URL=http://localhost:8080/api
FRONTEND_WS_URL=http://localhost:8080/ws
FRONTEND_BACKEND_ORIGIN=http://localhost:8080

# RabbitMQ (채팅 STOMP 브로커)
# guest/guest 는 localhost 외부 접속이 막혀 컨테이너 간 통신에서 거부되므로 전용 계정을 쓴다.
# host/port 는 compose 가 backend 에 직접 주입(rabbitmq:61613)하므로 여기엔 계정만 둔다.
RABBITMQ_USERNAME=appuser
RABBITMQ_PASSWORD=change-me-local-rabbitmq-password

# Docker Hub 이미지 태그 (nexusops0713/gamehouse:backend-<여기>)
# CI가 develop 브랜치 머지 시 backend-develop / frontend-develop 을 푸시한다.
# 특정 커밋으로 고정하거나 롤백하려면 커밋 SHA를 넣는다. 예) BACKEND_VERSION=3f1a9c2...
BACKEND_VERSION=develop
FRONTEND_VERSION=develop
