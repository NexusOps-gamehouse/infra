  "panels": [
    {
      "type": "stat",
      "title": "수집 상태 (up)",
      "description": "Prometheus 가 각 대상을 긁는 데 성공했는지. UP=1, DOWN=0.\n\n여기가 빨간색이면 그 job 이 담당하는 아래 패널은 전부 빈다. 그래프가 안 보일 때 가장 먼저 볼 곳.\n\njob 별 담당:\n  prometheus — 수집기 자신\n  cadvisor   — 컨테이너 CPU/메모리\n  node       — 호스트 디스크/메모리\n  backend    — 응답시간, 5xx, 채팅, Riot\n  rabbitmq   — 채팅 큐",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "text": {
          "titleSize": 15,
          "valueSize": 26
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "전체 컨테이너 CPU %",
      "description": "장애 대응의 출발점. 모든 컨테이너를 한 화면에 겹쳐 '누가 언제부터 바빠졌나'를 먼저 본다.\n컨테이너를 따로따로 보면 비교가 안 되어 범인을 못 찾는다.\n\n100% = CPU 코어 1개를 꽉 쓰는 중. 상한이 아니다 —\n코어가 여러 개면 100% 를 넘을 수 있다(t3.small 은 2코어이므로 최대 200%).\n\n_total 로 끝나는 counter 는 누적값이라 rate() 로 감싼다.\n결과 단위가 '코어 수'이므로 *100 이 %.\n\n호스트 전체 CPU 는 아래 '호스트 메모리 여유 / CPU 포화도' 패널에서 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"gamehouse-.*\"}[1m]) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "전체 컨테이너 메모리",
      "description": "단위는 MB / GB (1000 단위). Grafana 의 MiB(1024 단위)와는 약 5% 차이가 나지만\n감시 목적에는 영향이 없어 익숙한 표기를 쓴다.\n\n대략의 정상 범위 (참고용)\n  backend (Spring Boot) — 300~600 MB\n  db (PostgreSQL)       — 30~100 MB\n  rabbitmq              — 100~200 MB\n  frontend (serve)      — 30~80 MB\n\n중요한 것은 절대값보다 '모양'이다. 톱니처럼 오르내리면 GC 가 도는 정상 패턴,\n한 방향으로 계속 우상향하면 누수를 의심한다.\n\nworking set = 회수 불가능한 실사용분. usage 는 캐시를 포함해 부풀려 보이므로\nOOM 판단에는 working set 을 쓴다.\n\n호스트 전체 메모리는 아래 '호스트 메모리 여유 / CPU 포화도' 패널에서 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 3,
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0,
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "container_memory_working_set_bytes{name=~\"gamehouse-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "요청량 (분당, 엔드포인트별)",
      "description": "응답시간과 에러를 해석하려면 '얼마나 오는가'를 같이 봐야 한다.\n\n  p95 가 뚝 떨어졌다 → 빨라진 건가? 요청이 0 이면 아무도 안 쓴 것이다.\n  5xx 가 0 건이다   → 정상인가? 요청도 0 이면 판단할 수 없다.\n  CPU 가 급증했다   → 요청이 3배면 트래픽 증가가 원인이다.\n\n'전체' 선은 or vector(0) 으로 항상 그려진다. 이 선이 0 이면 수집은 정상인데\n트래픽이 없는 것이고, 선 자체가 없으면 backend job 이 DOWN 인 것이다.\n\n제외한 것 (API 3종 세트 공통)\n  /actuator/*  Prometheus 가 15초마다 긁어가는 수집 요청. 앱 트래픽이 아니다\n  /ws/*        SockJS 연결. 25초씩 열려 있다 끊기며 기록되어 그래프를 왜곡한다.\n               채팅은 전용 패널(큐 적체 / 동시 접속자)에서 본다\n\n알아두면 좋은 것: /api/notifications 는 NavBar 가 10초마다 폴링한다.\n사용자가 브라우저를 켜두기만 해도 1인당 분당 6회가 들어오므로,\n이 선이 유독 평평하고 높은 것은 정상이다.\n\n/uploads/** 처럼 별표가 붙는 것은 URI 템플릿이다. 실제 파일명이 그대로 들어가면\n업로드 파일 하나당 시계열이 생겨 카디널리티가 폭발하므로 Spring 이 패턴으로 기록한다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "id": 12,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "전체"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"backend\",uri!~\"/actuator.*|/ws/.*\"}[5m])) * 60",
          "legendFormat": "{{uri}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"backend\",uri!~\"/actuator.*|/ws/.*\"}[5m])) * 60 or vector(0)",
          "legendFormat": "전체"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "앱 응답시간 p95 (엔드포인트별)",
      "description": "요청 100건 중 95번째로 느린 요청의 소요 시간. 평균은 소수의 느린 요청을 가려버리므로 p95 를 본다.\n\n컨테이너 CPU 는 한가한데 이 값만 치솟으면 원인이 컨테이너 밖(DB, 외부 API, 네트워크)에 있다는 뜻이다.\n\n트래픽이 없으면 데이터도 없다. 요청을 몇 번 보내면 나타난다:\n  for i in $(seq 1 50); do curl -s http://localhost:8080/api/posts > /dev/null; done",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "id": 6,
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "decimals": 1,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri!~\"/actuator.*|/ws/.*\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "에러 발생 건수",
      "description": "최근 5분 동안 발생한 서버 오류(5xx) 건수. 비율이 아니라 실제 건수라 바로 읽힌다.\n\n0 이 정상이다. 1 건이라도 올라오면 그 시각의 backend 로그를 확인한다:\n  docker compose logs backend --since 10m | grep -i error\n\n4xx(잘못된 요청)는 사용자 입력 문제라 여기 포함하지 않는다.\n서버가 처리하다 실패한 5xx 만 센다.\n\n'전체' 선은 or vector(0) 으로 항상 그려진다. 에러가 하나도 없을 때 빈 화면 대신\n0 을 보여주기 위한 것이다. 에러가 나면 그 위에 엔드포인트별 막대가 함께 뜬다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "id": 7,
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "drawStyle": "bars"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (uri) (increase(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\",uri!~\"/actuator.*|/ws/.*\"}[5m]))",
          "legendFormat": "{{uri}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\",uri!~\"/actuator.*|/ws/.*\"}[5m])) or vector(0)",
          "legendFormat": "전체"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "채팅 — 큐 적체 / 동시 접속자",
      "description": "대기 중 메시지(rabbitmq_queue_messages_ready) = 브로커에 쌓여 아직 소비되지 않은 메시지 수.\n\n0 근처에서 머물면 정상이다. 계속 늘어나면 소비 속도가 생산 속도를 못 따라가는 것 =\n채팅이 밀리고 있다는 뜻. 이때 backend CPU 와 응답시간을 함께 확인한다.\n\n앱의 chat_active_sessions 는 '지금 몇 명이 붙어 있나'를 보여준다.\n접속자가 늘었는데 큐도 같이 늘면 용량 한계 신호.",
      "datasource": {
