            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "롤백 비율 / 데드락",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "description": "트랜잭션이 성공하면 commit, 실패해 되돌리면 rollback 이다.\n롤백이 평소보다 튀면 앱에서 예외가 터지고 있다는 뜻이다.\n\n'에러 발생 건수' 패널과 함께 보면 원인이 좁혀진다\n  5xx 오름 + 롤백 오름   → DB 작업에서 예외 발생\n  5xx 오름 + 롤백 평소   → DB 밖에서 터짐 (외부 API 실패 등)\n\n데드락은 오른쪽 축이다. 평소 0 이어야 하고 1 이라도 나오면 코드 문제다.\n두 트랜잭션이 서로가 쥔 잠금을 기다리며 맞물린 상태로, PostgreSQL 이 한쪽을\n강제로 죽여서 푼다. 죽은 쪽 요청은 실패한다.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
