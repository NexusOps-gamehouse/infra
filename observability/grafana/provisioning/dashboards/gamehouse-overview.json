      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\"gamehouse-.*\"}[5m])) + sum by (name) (rate(container_network_transmit_bytes_total{name=~\"gamehouse-.*\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ]
