      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "stat",
      "title": "5xx 비율 (판정)",
      "description": "SLO: < 0.1%\n\n서버가 센 값이다(http_server_requests). k6 의 http_req_failed 는 4xx 를 정상으로 재정의했기 때문에 5xx 판정에는 서버측을 쓴다.\n\n4xx 는 SLO 대상이 아니다 — 중복 신청·본인 글 같은 비즈니스 거절은 정상 동작이다.\n\n쿼리에 'or vector(0)' 이 붙어 있다. 5xx 가 하나도 없으면 분자가 빈 결과가 되어 패널이 통째로 비는데, 그러면 '5xx 가 없어서 정상'인지 '쿼리가 깨져서 안 보이는'지 구분할 수 없다. 0 으로 채워 두면 정상일 때 0.000% 가 보인다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"backend\",status=~\"5..\"}[1m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"backend\"}[1m])), 0.001)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area"
      }
    },
